#!/usr/bin/env bash

set -uo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=../lib/dependencies.sh
source "$ROOT_DIR/lib/dependencies.sh"
# shellcheck source=../lib/request.sh
source "$ROOT_DIR/lib/request.sh"
# shellcheck source=../lib/params.sh
source "$ROOT_DIR/lib/params.sh"
# shellcheck source=../lib/body.sh
source "$ROOT_DIR/lib/body.sh"
# shellcheck source=../lib/response.sh
source "$ROOT_DIR/lib/response.sh"
# shellcheck source=../lib/errors.sh
source "$ROOT_DIR/lib/errors.sh"
# shellcheck source=../lib/openapi.sh
source "$ROOT_DIR/lib/openapi.sh"
# shellcheck source=../lib/validation.sh
source "$ROOT_DIR/lib/validation.sh"
# shellcheck source=../middleware/request-id.sh
source "$ROOT_DIR/middleware/request-id.sh"
# shellcheck source=../middleware/logging.sh
source "$ROOT_DIR/middleware/logging.sh"
# shellcheck source=../lib/middleware.sh
source "$ROOT_DIR/lib/middleware.sh"
# shellcheck source=../lib/router.sh
source "$ROOT_DIR/lib/router.sh"
# shellcheck source=../lib/server.sh
source "$ROOT_DIR/lib/server.sh"

print_help() {
	cat <<'EOF'
Usage:
  bash-http help
  bash-http serve OPENAPI_FILE [--host HOST] [--port PORT]
  bash-http routes OPENAPI_FILE
  bash-http validate OPENAPI_FILE

Commands:
  help      Show this help.
  serve     Start the HTTP server.
  routes    List operations discovered from OpenAPI.
  validate  Validate the supported OpenAPI routing subset.

Serve defaults:
  host: 127.0.0.1
  port: 8080
EOF
}

serve_command() {
	local host='127.0.0.1'
	local port='8080'
	local openapi_file

	if (($# == 0)) || [[ $1 == --* ]]; then
		printf 'The serve command requires an OpenAPI file.\n' >&2
		return 2
	fi
	openapi_file=$1
	shift

	while (($# > 0)); do
		case $1 in
		--host | --port)
			if (($# < 2)); then
				printf 'Missing value for %s.\n' "$1" >&2
				return 2
			fi
			if [[ $1 == '--host' ]]; then
				host=$2
			else
				port=$2
			fi
			shift 2
			;;
		*)
			printf 'Unknown serve option: %s.\n' "$1" >&2
			return 2
			;;
		esac
	done

	validate_host "$host" || return 2
	validate_port "$port" || return 2
	require_yq_v4 || return 1
	if ! openapi_load_routes "$openapi_file"; then
		printf '%s\n' "$OPENAPI_ERROR" >&2
		return 1
	fi
	if [[ " ${OPENAPI_MIDDLEWARE_NAMES[*]} " == *' logging '* ]]; then
		require_command jq || return 1
	fi
	require_command socat || return 1
	start_server "$host" "$port" "$ROOT_DIR/bin/bash-http" "$openapi_file"
}

openapi_command() {
	local command=$1
	local openapi_file=${2:-}

	if (($# != 2)); then
		printf 'The %s command requires exactly one OpenAPI file.\n' "$command" >&2
		return 2
	fi
	require_yq_v4 || return 1
	if ! openapi_load_routes "$openapi_file"; then
		printf '%s\n' "$OPENAPI_ERROR" >&2
		return 1
	fi
	if [[ $command == 'routes' ]]; then
		openapi_print_routes
	else
		printf 'OpenAPI document is valid.\n'
	fi
}

main() {
	local command=${1:-help}
	if (($# > 0)); then
		shift
	fi

	check_bash_version || return 1
	case $command in
	help | --help | -h)
		if (($# > 0)); then
			printf 'The help command does not accept arguments.\n' >&2
			return 2
		fi
		print_help
		;;
	serve) serve_command "$@" ;;
	routes | validate) openapi_command "$command" "$@" ;;
	__handle-connection)
		if (($# != 1)); then
			printf 'The private connection operation requires an OpenAPI file.\n' >&2
			return 2
		fi
		require_yq_v4 || return 1
		trap body_cleanup EXIT INT TERM
		handle_connection "$1" "$ROOT_DIR/handlers"
		;;
	*)
		printf 'Unknown command: %s.\n' "$command" >&2
		print_help >&2
		return 2
		;;
	esac
}

main "$@"
